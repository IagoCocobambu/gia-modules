# Copie para `.env` (gitignored) e preencha. NUNCA faça commit do `.env`.
# Em PROD nada disto existe: o DW já vem conectado no `sql` do SDK, a credencial
# da API de notas vem do hub de Credenciais e o loc_ref vem do cadastro da Empresa (BIAPI).

# DW (contas do Simphony — schema simphony_api_bi). Só leitura.
GIA_SERVER_DATABASE_URL=postgres://usuario:senha@host:5432/dw

# API de notas (api-dw.cocobambu.com) — credencial da integração `api-dw`.
GIA_DEV_CRED_API_DW_BASE_URL=https://api-dw.cocobambu.com
GIA_DEV_CRED_API_DW_TOKEN=
