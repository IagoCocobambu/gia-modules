# Copie para `.env` (gitignored) e preencha. NUNCA faça commit do `.env`.
# Em PROD nada disto existe: a credencial da 99Food vem do hub de Credenciais do
# portal (integração `99food`), o banco do Maestro vem do secret da Edge Function, o
# número da loja vem do cadastro da Empresa (nome ou vínculo BIAPI) e as lojas da
# 99Food vêm dos vínculos 99FOOD das operações (`ctx.operacoes()`).

# Financial API da 99Food — credencial da integração `99food`. O token sai do
# POST /v3/auth/authtoken/signIn (retailer = app_id, secret = app_secret) e vale 6 h;
# o dev-shell não renova. A Financial API precisa de autorização da 99 (pedida por
# e-mail) — enquanto não houver, use o modo demo abaixo.
GIA_DEV_CRED_99FOOD_BASE_URL=https://openapi.99food.com
# Token gerado no signIn (Postman). Renove na mão a cada ~5 h e reinicie o gia dev.
GIA_DEV_CRED_99FOOD_TOKEN=
# Só ANOTAÇÃO (o gia dev não lê): data-hora ISO em que o token vence, ex.:
# 2026-11-17T23:30:00Z. Não é a duração nem a regra de renovação — em produção quem
# renova (1 h antes de vencer) é o hub de Credenciais do portal.
GIA_DEV_CRED_99FOOD_EXPIRES_AT=

# Banco do Maestro: leitura de bordero.borderos + bordero.fields e leitura/gravação no
# schema fechamento_99food (criado pelo sql-maestro/001_schema.sql — ainda NÃO rodado).
GIA_SERVER_DATABASE_URL=postgres://usuario:senha@host:5432/maestro

# Trava de teste da gravação (padrão 12): id da Empresa em que o Salvar pode gravar.
# Homologação e produção gravam no MESMO banco do Maestro — em homologação defina com a
# Empresa de teste (999.CB TECH HOMOLOG = 93); o Salvar recusa as outras com 403. Em
# produção NÃO defina. No dev, deixe 93 sempre que o GIA_SERVER_DATABASE_URL for um
# banco de verdade.
FECHAMENTO_99FOOD_MENSAL_EMPRESA_TESTE=93

# Só no dev: 1 = lançamentos da 99 fictícios (sem a Financial API). Sem
# GIA_SERVER_DATABASE_URL, o borderô também é fictício (não use em prod).
GIA_DEV_99FOOD_MENSAL_DEMO=
# Só dev, com GIA_DEV_99FOOD_MENSAL_DEMO=1: atraso (ms) por página para simular a demora da API.
GIA_DEV_99FOOD_MENSAL_DEMO_ATRASO_MS=
# Só dev, TESTE: 1 = mostra o seletor "Operação (teste)" para consultar UMA operação da
# loja (com operação escolhida não salva). 0 ou ausente = junta todas as operações.
GIA_DEV_99FOOD_MENSAL_POR_OPERACAO=0
