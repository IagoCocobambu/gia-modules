{
  "name": "@modules/fechamento-ifood-diario",
  "version": "0.1.0",
  "description": "Fechamento diário dos pedidos iFood de uma loja: cruza os pedidos do DW com a API financeira do iFood, classifica as formas de pagamento (Online, Adquirentes/VR, Offline) e soma os cards do fechamento. Substitui a tela Fechamento iFood Diário do GIA antigo.",
  "private": true,
  "type": "module",
  "author": "Iago Pereira <iago.pereira@cocobambu.com>",
  "files": [
    "src",
    "PRD.md",
    "INTEGRATION.md",
    "README.md",
    "CHANGELOG.md",
    "gia.config.ts",
    "tsconfig.json",
    "assets",
    "migrations",
    "edge-functions",
    "validation-report.json"
  ],
  "scripts": {
    "predev": "node ../scripts/token-ifood.mjs --se-vencido",
    "dev": "gia dev",
    "validate": "gia validate",
    "format": "prettier --write .",
    "pack": "gia pack",
    "token:ifood": "node ../scripts/token-ifood.mjs"
  },
  "dependencies": {
    "@gia-cb/sdk": "0.1.0-alpha.70",
    "@gia-cb/ui": "0.1.0-alpha.70",
    "@tanstack/react-query": "^5.106.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@gia-cb/cli": "0.1.0-alpha.70",
    "@gia-cb/dev-shell": "0.1.0-alpha.70",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.8.3",
    "typescript": "~5.8.3",
    "@types/node": "^26.6.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msw@2.15.0": true
  }
}
