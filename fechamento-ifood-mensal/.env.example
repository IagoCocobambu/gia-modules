# Copie para `.env` (gitignored) e preencha. NUNCA faça commit do `.env`.
# Em PROD nada disto existe: a credencial do iFood vem do hub de Credenciais do
# portal (integração `ifood`), o banco do Maestro vem do secret da Edge Function e
# o merchant/número da loja vêm do cadastro da Empresa.

# Merchant API do iFood — credencial da integração `ifood` (a mesma nos módulos
# Fechamento iFood Diário e Mensal). O token vence em ~6 h e o dev-shell não o renova:
# o `npm run dev` roda antes o `predev`, que gera um token novo com o client id/secret
# abaixo quando falta menos de 30 min. Para renovar na hora: `npm run token:ifood`
# (e reinicie o gia dev). Os dois GIA_DEV_IFOOD_CLIENT_* são só do dev — em produção
# ficam no hub de Credenciais.
GIA_DEV_IFOOD_CLIENT_ID=
GIA_DEV_IFOOD_CLIENT_SECRET=
GIA_DEV_CRED_IFOOD_BASE_URL=https://merchant-api.ifood.com.br
# Preenchidos pelo script:
GIA_DEV_CRED_IFOOD_TOKEN=
GIA_DEV_CRED_IFOOD_EXPIRES_AT=

# Banco do Maestro (o `UniConnMaestro` do legado): leitura de bordero.borderos e
# leitura/gravação no schema ifood_fechamento.
GIA_SERVER_DATABASE_URL=postgres://usuario:senha@host:5432/maestro

# Só no dev: 1 = vendas e borderô fictícios, sem iFood e sem banco (não use em prod).
GIA_DEV_IFOOD_MENSAL_DEMO=
# Só dev, com GIA_DEV_IFOOD_MENSAL_DEMO=1: atraso (ms) por página para simular a demora do iFood.
GIA_DEV_IFOOD_MENSAL_DEMO_ATRASO_MS=
