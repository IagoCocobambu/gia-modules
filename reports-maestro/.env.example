# Copie para `.env` (gitignored) e preencha. NUNCA faça commit do `.env`.
# Em PROD nada disto existe: a credencial da API do DW vem do hub de Credenciais
# do portal (integração `apidw`) e o número da loja vem do nome da Empresa.

# API do DW (api-dw.cocobambu.com) — credencial da integração `apidw`.
GIA_DEV_CRED_APIDW_BASE_URL=https://api-dw.cocobambu.com
GIA_DEV_CRED_APIDW_TOKEN=
